    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nsabores/validation": "workspace:*",
    "@prisma/client": "^6.19.0",
    "joi": "^18.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.7",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prisma": "^7.9.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.34.0",
    "vitest": "^4.1.10"
  }
