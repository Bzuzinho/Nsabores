{
  "name": "@nsabores/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"dist/**\" --exclude \"dist-smoke/**\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed:demo": "tsx prisma/demo-seed-clear-extra-orders.ts && tsx prisma/demo-seed-clear-extended.ts && tsx prisma/demo-seed.ts && tsx prisma/demo-seed-operations.ts && tsx prisma/demo-seed-commerce.ts && tsx prisma/demo-seed-membership.ts && tsx prisma/demo-seed-validate.ts",
    "prisma:seed:demo:clear": "tsx prisma/demo-seed-clear-extra-orders.ts && tsx prisma/demo-seed-clear-extended.ts && tsx prisma/demo-seed-clear.ts",
    "prisma:seed:demo:reset": "pnpm run prisma:seed:demo:clear && pnpm run prisma:seed:demo",
    "prisma:seed:demo:validate": "tsx prisma/demo-seed-validate.ts",
    "prisma:seed:demo:clear:validate": "tsx prisma/demo-seed-clear-validate.ts",
    "validate:issue18": "tsx scripts/validate-issue-18.ts",
    "validate:club": "tsx scripts/validate-club-lifecycle.ts",
    "validate:club-manual": "pnpm build && node dist/smoke-manual-club.js",
    "validate:sprint10": "tsx scripts/validate-sprint10-acceptance.ts",
    "validate:fiscal": "pnpm build && node dist/smoke-fiscal.js",
    "validate:fiscal-sources": "pnpm build && node dist/smoke-fiscal-sources.js",
    "validate:fiscal-provider": "pnpm build && node dist/smoke-fiscal-provider.js",
    "validate:fiscal-reconciliation": "pnpm build && node dist/smoke-fiscal-reconciliation.js",
    "validate:loyalty": "tsx scripts/smoke-loyalty.ts",
    "validate:loyalty-checkout": "pnpm build && node dist/smoke-loyalty-checkout.js",
    "validate:management": "pnpm build && node dist/smoke-management.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nsabores/types": "workspace:*",
    "@nsabores/validation": "workspace:*",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "joi": "^18.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.7",
    "@types/node": "^26.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "prisma": "^7.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^4.1.10"
  }
}
