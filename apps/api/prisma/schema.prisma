generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REJECTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryMethodType {
  STANDARD
  LOCAL_PICKUP
}

enum StockMovementType {
  PURCHASE_RECEIPT
  ORDER_RESERVATION
  ORDER_RELEASE
  ORDER_FULFILLMENT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  LOSS
  INVENTORY_CORRECTION
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BusinessAccountType {
  RESELLER
  B2B
}

enum BusinessAccountStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum BusinessAccountUserRole {
  OWNER
  BUYER
  VIEWER
}

enum ResellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PriceListType {
  RETAIL
  RESELLER
  CUSTOM
}

enum SalesChannel {
  B2C
  B2B
}

enum ProductChannel {
  B2C_ONLY
  B2B_ONLY
  BOTH
}

enum PaymentTerms {
  IMMEDIATE
  BANK_TRANSFER
  NET_15
  NET_30
  NET_60
}

enum SaleUnit {
  UNIT
  PACK
  CASE
}

enum ShipmentStatus {
  PENDING
  READY
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum ReturnRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  REFUND_PENDING
  REFUNDED
  CLOSED
  CANCELLED
}

enum ReturnResolution {
  REFUND
  REPLACEMENT
  CREDIT
  OTHER
}

enum ReturnItemDisposition {
  RESTOCK
  UNSELLABLE
  RETURN_TO_SUPPLIER
  DESTROY
}

enum SupportCaseType {
  DELAY
  LOST_SHIPMENT
  DAMAGED_PACKAGE
  DAMAGED_PRODUCT
  MISSING_ITEM
  WRONG_ITEM
  FAILED_DELIVERY
  RETURN_TO_SENDER
  OTHER
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_CARRIER
  RESOLVED
  CLOSED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum PromotionBenefitType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  SPECIAL_PRICE
  QUANTITY_DEAL
}

enum PromotionChannel {
  B2C
  B2B
  BOTH
}

enum BundleMode {
  FIXED
  CONFIGURABLE
}

enum BundlePricingMode {
  PRODUCT_PRICE
  COMPONENT_TOTAL
}

model Category {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  description      String?
  imageUrl         String?
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  promotionTargets PromotionTarget[]

  @@index([isActive, sortOrder])
}

model Product {
  id                    String                         @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String                         @unique
  shortDescription      String
  description           String?
  sku                   String                         @unique
  priceCents            Int
  compareAtPriceCents   Int?
  imageUrl              String
  gallery               String[]                       @default([])
  isActive              Boolean                        @default(true)
  isFeatured            Boolean                        @default(false)
  stockStatus           StockStatus                    @default(IN_STOCK)
  channel               ProductChannel                 @default(BOTH)
  minimumOrderQuantity  Int                            @default(1)
  orderMultiple         Int                            @default(1)
  caseSize              Int?
  saleUnit              SaleUnit                       @default(UNIT)
  categoryId            String                         @db.Uuid
  category              Category                       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  cartItems             CartItem[]
  orderItems            OrderItem[]
  stockItem             StockItem?
  stockMovements        StockMovement[]
  stockReservations     StockReservation[]
  supplierProducts      SupplierProduct[]
  purchaseOrderItems    PurchaseOrderItem[]
  inventoryCountItems   InventoryCountItem[]
  priceListItems        PriceListItem[]
  promotionTargets      PromotionTarget[]
  bundle                ProductBundle?
  bundleComponents      ProductBundleItem[]
  personalization       ProductPersonalization?
  cartBundleSelections  CartItemBundleSelection[]
  orderBundleSelections OrderItemBundleSelection[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([stockStatus])
  @@index([createdAt])
}

model User {
  id                         String                @id @default(uuid()) @db.Uuid
  email                      String                @unique
  passwordHash               String
  firstName                  String
  lastName                   String
  phone                      String?
  role                       UserRole              @default(CUSTOMER)
  isActive                   Boolean               @default(true)
  emailVerifiedAt            DateTime?
  lastLoginAt                DateTime?
  passwordResetTokenHash     String?               @unique
  passwordResetExpiresAt     DateTime?
  emailVerificationTokenHash String?               @unique
  emailVerificationExpiresAt DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  customerProfile            CustomerProfile?
  addresses                  Address[]
  authSessions               AuthSession[]
  carts                      Cart[]
  orders                     Order[]
  orderStatusChanges         OrderStatusHistory[]  @relation("OrderStatusAuthor")
  stockMovements             StockMovement[]       @relation("StockMovementAuthor")
  purchaseOrders             PurchaseOrder[]       @relation("PurchaseOrderAuthor")
  purchaseReceipts           PurchaseReceipt[]     @relation("PurchaseReceiptAuthor")
  inventoryCounts            InventoryCount[]      @relation("InventoryCountAuthor")
  businessMemberships        BusinessAccountUser[]
  managedBusinessAccounts    BusinessAccount[]     @relation("BusinessAccountManager")
  approvedOrders             Order[]               @relation("OrderApprover")
  returnRequests             ReturnRequest[]
  returnEvents               ReturnEvent[]         @relation("ReturnEventAuthor")
  supportCases               SupportCase[]         @relation("SupportCaseCustomer")
  assignedSupportCases       SupportCase[]         @relation("SupportCaseAssignee")
  supportCaseComments        SupportCaseComment[]  @relation("SupportCaseCommentAuthor")
  couponRedemptions          CouponRedemption[]
  blogPosts                  BlogPost[]             @relation("BlogPostAuthor")

  @@index([role, isActive])
}

model Cart {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  sessionId String?        @db.Uuid
  status    CartStatus     @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  promotion CartPromotion?

  @@unique([userId, status])
  @@unique([sessionId, status])
  @@index([updatedAt])
}

model CartItem {
  id              String                    @id @default(uuid()) @db.Uuid
  cartId          String                    @db.Uuid
  productId       String                    @db.Uuid
  quantity        Int
  unitPriceCents  Int
  configurationKey String                   @default("default")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  cart            Cart                      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  bundleSelections CartItemBundleSelection[]
  personalization CartItemPersonalization?

  @@unique([cartId, productId, configurationKey])
  @@index([productId])
  @@index([cartId, configurationKey])
}

model DeliveryMethod {
  id                     String             @id @default(uuid()) @db.Uuid
  code                   String             @unique
  name                   String
  type                   DeliveryMethodType
  isActive               Boolean            @default(true)
  priceCents             Int                @default(0)
  freeShippingAboveCents Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  orders                 Order[]

  @@index([isActive])
}

model Order {
  id                   String               @id @default(uuid()) @db.Uuid
  number               String               @unique
  userId               String?              @db.Uuid
  email                String
  customerName         String
  phone                String
  status               OrderStatus          @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus        @default(PENDING)
  subtotalCents        Int
  shippingCents        Int
  discountCents        Int                  @default(0)
  taxCents             Int                  @default(0)
  totalCents           Int
  currency             String               @default("EUR") @db.Char(3)
  billingAddress       Json
  shippingAddress      Json
  customerNotes        String?
  internalNotes        String?
  source               String               @default("WEBSITE")
  deliveryMethodId     String               @db.Uuid
  idempotencyKey       String               @unique
  salesChannel         SalesChannel         @default(B2C)
  businessAccountId    String?              @db.Uuid
  priceListId          String?              @db.Uuid
  paymentTermsSnapshot Json?
  customerReference    String?
  requiresApproval     Boolean              @default(false)
  approvedBy           String?              @db.Uuid
  approvedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveryMethod       DeliveryMethod       @relation(fields: [deliveryMethodId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  payments             Payment[]
  statusHistory        OrderStatusHistory[]
  stockReservations    StockReservation[]
  stockMovements       StockMovement[]
  businessAccount      BusinessAccount?     @relation(fields: [businessAccountId], references: [id], onDelete: Restrict)
  priceList            PriceList?           @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  approver             User?                @relation("OrderApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  shipments            Shipment[]
  returnRequests       ReturnRequest[]
  supportCases         SupportCase[]
  couponRedemptions    CouponRedemption[]
  discounts            OrderDiscount[]

  @@index([userId, createdAt])
  @@index([status, paymentStatus, createdAt])
  @@index([businessAccountId, createdAt])
  @@index([salesChannel, createdAt])
}

model OrderItem {
  id                  String                     @id @default(uuid()) @db.Uuid
  orderId             String                     @db.Uuid
  productId           String?                    @db.Uuid
  productName         String
  sku                 String
  unitPriceCents      Int
  quantity            Int
  totalCents          Int
  imageUrl            String?
  createdAt           DateTime                   @default(now())
  order               Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  shipmentItems       ShipmentItem[]
  returnItems         ReturnItem[]
  bundleSelections    OrderItemBundleSelection[]
  personalization     OrderItemPersonalization?

  @@index([orderId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  provider          String
  providerPaymentId String        @unique
  method            String
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  currency          String        @default("EUR") @db.Char(3)
  metadata          Json?
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  authorId   String?      @db.Uuid
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author     User?        @relation("OrderStatusAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model ProcessedWebhook {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
}

model CustomerProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @db.Uuid
  taxNumber          String?
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  label             String
  firstName         String
  lastName          String
  company           String?
  taxNumber         String?
  line1             String
  line2             String?
  postalCode        String
  city              String
  countryCode       String   @default("PT") @db.Char(2)
  phone             String?
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model StockItem {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @unique @db.Uuid
  onHandQuantity   Int      @default(0)
  reservedQuantity Int      @default(0)
  reorderPoint     Int?
  reorderQuantity  Int?
  trackStock       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([trackStock, onHandQuantity])
}

model StockMovement {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @db.Uuid
  type           StockMovementType
  quantity       Int
  referenceType  String
  referenceId    String
  idempotencyKey String                @unique
  note           String?
  authorId       String?               @db.Uuid
  orderId        String?               @db.Uuid
  createdAt      DateTime              @default(now())
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  author         User?                 @relation("StockMovementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receiptItems   PurchaseReceiptItem[]
  inventoryItems InventoryCountItem[]

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([orderId])
}

model StockReservation {
  id             String                 @id @default(uuid()) @db.Uuid
  productId      String                 @db.Uuid
  orderId        String?                @db.Uuid
  quantity       Int
  status         StockReservationStatus @default(ACTIVE)
  expiresAt      DateTime?
  idempotencyKey String                 @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  order          Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@index([orderId, status])
  @@index([expiresAt, status])
}

model Supplier {
  id                  String            @id @default(uuid()) @db.Uuid
  tradeName           String
  legalName           String?
  taxNumber           String?
  email               String
  phone               String
  website             String?
  primaryContact      String?
  address             Json
  paymentTerms        String?
  defaultCurrency     String            @default("EUR") @db.Char(3)
  averageLeadTimeDays Int?
  internalNotes       String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  products            SupplierProduct[]
  purchaseOrders      PurchaseOrder[]

  @@index([isActive, tradeName])
}

model SupplierProduct {
  id                String   @id @default(uuid()) @db.Uuid
  supplierId        String   @db.Uuid
  productId         String   @db.Uuid
  supplierSku       String
  purchaseCostCents Int
  minimumQuantity   Int      @default(1)
  purchaseMultiple  Int      @default(1)
  unitsPerCase      Int?
  leadTimeDays      Int?
  isPreferred       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([supplierId, productId])
  @@unique([supplierId, supplierSku])
  @@index([productId, isPreferred])
}

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  number               String              @unique
  supplierId           String              @db.Uuid
  status               PurchaseOrderStatus @default(DRAFT)
  issuedAt             DateTime?
  expectedAt           DateTime?
  receivedAt           DateTime?
  subtotalCents        Int
  taxCents             Int                 @default(0)
  totalCents           Int
  currency             String              @default("EUR") @db.Char(3)
  paymentTermsSnapshot String?
  notes                String?
  authorId             String?             @db.Uuid
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  author               User?               @relation("PurchaseOrderAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  items                PurchaseOrderItem[]
  receipts             PurchaseReceipt[]

  @@index([supplierId, status])
  @@index([status, expectedAt])
}

model PurchaseOrderItem {
  id                 String                @id @default(uuid()) @db.Uuid
  purchaseOrderId    String                @db.Uuid
  productId          String                @db.Uuid
  supplierSku        String
  description        String
  orderedQuantity    Int
  receivedQuantity   Int                   @default(0)
  unitCostCents      Int
  taxRateBasisPoints Int?
  totalCents         Int
  createdAt          DateTime              @default(now())
  purchaseOrder      PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  product            Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems       PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseReceipt {
  id              String                @id @default(uuid()) @db.Uuid
  purchaseOrderId String                @db.Uuid
  number          String                @unique
  receivedAt      DateTime              @default(now())
  authorId        String?               @db.Uuid
  note            String?
  idempotencyKey  String                @unique
  createdAt       DateTime              @default(now())
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  author          User?                 @relation("PurchaseReceiptAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  items           PurchaseReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
}

model PurchaseReceiptItem {
  id                  String            @id @default(uuid()) @db.Uuid
  purchaseReceiptId   String            @db.Uuid
  purchaseOrderItemId String            @db.Uuid
  quantity            Int
  stockMovementId     String            @unique @db.Uuid
  createdAt           DateTime          @default(now())
  purchaseReceipt     PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  stockMovement       StockMovement     @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@unique([purchaseReceiptId, purchaseOrderItemId])
}

model InventoryCount {
  id          String               @id @default(uuid()) @db.Uuid
  number      String               @unique
  status      InventoryCountStatus @default(DRAFT)
  referenceAt DateTime
  authorId    String?              @db.Uuid
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  author      User?                @relation("InventoryCountAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  items       InventoryCountItem[]

  @@index([status, referenceAt])
}

model InventoryCountItem {
  id               String         @id @default(uuid()) @db.Uuid
  inventoryCountId String         @db.Uuid
  productId        String         @db.Uuid
  expectedQuantity Int
  countedQuantity  Int?
  reason           String?
  stockMovementId  String?        @unique @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Restrict)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovement    StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@unique([inventoryCountId, productId])
}

model PriceList {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  code             String            @unique
  type             PriceListType
  currency         String            @default("EUR") @db.Char(3)
  includesTax      Boolean           @default(true)
  priority         Int               @default(0)
  isActive         Boolean           @default(true)
  validFrom        DateTime?
  validUntil       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            PriceListItem[]
  businessAccounts BusinessAccount[]
  orders           Order[]
  promotionTargets PromotionTarget[]

  @@index([type, isActive, priority])
}

model PriceListItem {
  id                    String    @id @default(uuid()) @db.Uuid
  priceListId           String    @db.Uuid
  productId             String    @db.Uuid
  priceCents            Int
  promotionalPriceCents Int?
  minimumQuantity       Int?
  maximumQuantity       Int?
  validFrom             DateTime?
  validUntil            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  priceList             PriceList @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  product               Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([priceListId, productId])
  @@index([productId])
}

model BusinessAccount {
  id                    String                @id @default(uuid()) @db.Uuid
  type                  BusinessAccountType   @default(RESELLER)
  tradeName             String
  legalName             String
  taxNumber             String                @unique
  businessEmail         String
  phone                 String
  billingAddress        Json
  status                BusinessAccountStatus @default(PENDING)
  priceListId           String?               @db.Uuid
  paymentTerms          PaymentTerms          @default(IMMEDIATE)
  allowedPaymentMethods String[]              @default(["CARD"])
  creditLimitCents      Int?
  minimumOrderCents     Int?
  requiresApproval      Boolean               @default(false)
  shippingCents         Int?
  managerId             String?               @db.Uuid
  internalNotes         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  priceList             PriceList?            @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  manager               User?                 @relation("BusinessAccountManager", fields: [managerId], references: [id], onDelete: SetNull)
  users                 BusinessAccountUser[]
  orders                Order[]
  supportCases          SupportCase[]
  promotionTargets      PromotionTarget[]
  couponRedemptions     CouponRedemption[]

  @@index([status, tradeName])
}

model BusinessAccountUser {
  id                String                  @id @default(uuid()) @db.Uuid
  businessAccountId String                  @db.Uuid
  userId            String                  @db.Uuid
  role              BusinessAccountUserRole @default(BUYER)
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  businessAccount   BusinessAccount         @relation(fields: [businessAccountId], references: [id], onDelete: Restrict)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessAccountId, userId])
  @@index([userId, isActive])
}

model ResellerApplication {
  id                String                    @id @default(uuid()) @db.Uuid
  tradeName         String
  legalName         String
  taxNumber         String
  contactName       String
  email             String
  phone             String
  address           Json
  website           String?
  socialMedia       String?
  activity          String
  estimatedVolume   String?
  message           String?
  status            ResellerApplicationStatus @default(PENDING)
  decidedAt         DateTime?
  decidedBy         String?                   @db.Uuid
  internalReason    String?
  businessAccountId String?                   @unique @db.Uuid
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([taxNumber])
}

model Shipment {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @db.Uuid
  number              String          @unique
  provider            String
  service             String
  trackingNumber      String?
  trackingUrl         String?
  status              ShipmentStatus  @default(PENDING)
  weightGrams         Int?
  lengthMm            Int?
  widthMm             Int?
  heightMm            Int?
  costCents           Int             @default(0)
  currency            String          @default("EUR") @db.Char(3)
  labelUrl            String?
  providerShipmentId  String?
  idempotencyKey      String          @unique
  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items               ShipmentItem[]
  events              ShipmentEvent[]
  supportCases        SupportCase[]

  @@unique([provider, providerShipmentId])
  @@index([orderId, status])
  @@index([status, createdAt])
}

model ShipmentItem {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @db.Uuid
  orderItemId String    @db.Uuid
  quantity    Int
  createdAt   DateTime  @default(now())
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model ShipmentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  shipmentId      String   @db.Uuid
  providerEventId String
  code            String
  description     String
  location        String?
  occurredAt      DateTime
  payload         Json?
  createdAt       DateTime @default(now())
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerEventId])
  @@index([shipmentId, occurredAt])
}

model ReturnRequest {
  id            String              @id @default(uuid()) @db.Uuid
  number        String              @unique
  orderId       String              @db.Uuid
  userId        String?             @db.Uuid
  status        ReturnRequestStatus @default(REQUESTED)
  resolution    ReturnResolution
  reason        String
  customerNotes String?
  internalNotes String?
  requestedAt   DateTime            @default(now())
  decidedAt     DateTime?
  receivedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         ReturnItem[]
  events        ReturnEvent[]

  @@index([orderId, status])
  @@index([userId, createdAt])
}

model ReturnItem {
  id                    String                 @id @default(uuid()) @db.Uuid
  returnRequestId       String                 @db.Uuid
  orderItemId           String                 @db.Uuid
  quantity              Int
  reason                String
  declaredCondition     String?
  receivedCondition     String?
  disposition           ReturnItemDisposition?
  eligibleRefundCents   Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  returnRequest         ReturnRequest          @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem             OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
}

model ReturnEvent {
  id              String               @id @default(uuid()) @db.Uuid
  returnRequestId String               @db.Uuid
  fromStatus      ReturnRequestStatus?
  toStatus        ReturnRequestStatus
  authorId        String?              @db.Uuid
  note            String?
  createdAt       DateTime             @default(now())
  returnRequest   ReturnRequest        @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  author          User?                @relation("ReturnEventAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([returnRequestId, createdAt])
}

model SupportCase {
  id                String              @id @default(uuid()) @db.Uuid
  number            String              @unique
  userId            String?             @db.Uuid
  businessAccountId String?             @db.Uuid
  orderId           String?             @db.Uuid
  shipmentId        String?             @db.Uuid
  type              SupportCaseType
  priority          SupportCasePriority @default(NORMAL)
  status            SupportCaseStatus   @default(OPEN)
  subject           String
  description       String
  resolution        String?
  assignedToId      String?             @db.Uuid
  dueAt             DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  user              User?               @relation("SupportCaseCustomer", fields: [userId], references: [id], onDelete: SetNull)
  businessAccount   BusinessAccount?    @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment          Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  assignedTo        User?               @relation("SupportCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments          SupportCaseComment[]

  @@index([status, priority, createdAt])
  @@index([orderId])
  @@index([businessAccountId])
}

model SupportCaseComment {
  id            String      @id @default(uuid()) @db.Uuid
  supportCaseId String      @db.Uuid
  authorId      String?     @db.Uuid
  body          String
  isInternal    Boolean     @default(true)
  createdAt     DateTime    @default(now())
  supportCase   SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  author        User?       @relation("SupportCaseCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([supportCaseId, createdAt])
}

model NewsletterSubscription {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  source      String   @default("WEBSITE")
  isActive    Boolean  @default(true)
  consentedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, createdAt])
}

model Promotion {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String
  code                 String               @unique
  status               PromotionStatus      @default(DRAFT)
  benefitType          PromotionBenefitType
  benefitValue         Int                  @default(0)
  channel              PromotionChannel     @default(BOTH)
  startsAt             DateTime?
  endsAt               DateTime?
  priority             Int                  @default(0)
  stackable            Boolean              @default(false)
  globalUsageLimit     Int?
  perCustomerLimit     Int?
  minimumCartCents     Int?
  maximumDiscountCents Int?
  quantityBuy          Int?
  quantityPay          Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  targets              PromotionTarget[]
  coupons              Coupon[]
  cartPromotions       CartPromotion[]
  orderDiscounts       OrderDiscount[]

  @@index([status, channel, priority])
  @@index([startsAt, endsAt])
}

model PromotionTarget {
  id                String           @id @default(uuid()) @db.Uuid
  promotionId       String           @db.Uuid
  productId         String?          @db.Uuid
  categoryId        String?          @db.Uuid
  priceListId       String?          @db.Uuid
  businessAccountId String?          @db.Uuid
  minimumQuantity   Int?
  createdAt         DateTime         @default(now())
  promotion         Promotion        @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product           Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category          Category?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceList         PriceList?       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  businessAccount   BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([productId])
  @@index([categoryId])
  @@index([priceListId])
  @@index([businessAccountId])
}

model Coupon {
  id              String             @id @default(uuid()) @db.Uuid
  promotionId     String             @db.Uuid
  code            String             @unique
  isActive        Boolean            @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  usageLimit      Int?
  perUserLimit    Int?
  channel         PromotionChannel   @default(BOTH)
  minimumCartCents Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  promotion       Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions     CouponRedemption[]
  cartPromotions  CartPromotion[]
  orderDiscounts  OrderDiscount[]

  @@index([promotionId, isActive])
}

model CouponRedemption {
  id                String           @id @default(uuid()) @db.Uuid
  couponId          String           @db.Uuid
  orderId           String           @db.Uuid
  userId            String?          @db.Uuid
  businessAccountId String?          @db.Uuid
  amountCents       Int
  idempotencyKey    String           @unique
  redeemedAt        DateTime         @default(now())
  coupon            Coupon           @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessAccount   BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)

  @@index([couponId, redeemedAt])
  @@index([userId, couponId])
  @@index([businessAccountId, couponId])
}

model CartPromotion {
  id          String    @id @default(uuid()) @db.Uuid
  cartId      String    @unique @db.Uuid
  promotionId String    @db.Uuid
  couponId    String?   @db.Uuid
  code        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  cart        Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  coupon      Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
}

model OrderDiscount {
  id          String     @id @default(uuid()) @db.Uuid
  orderId     String     @db.Uuid
  promotionId String?    @db.Uuid
  couponId    String?    @db.Uuid
  source      String
  code        String?
  label       String
  amountCents Int
  snapshot    Json
  createdAt   DateTime   @default(now())
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  coupon      Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ProductBundle {
  id                String              @id @default(uuid()) @db.Uuid
  productId         String              @unique @db.Uuid
  mode              BundleMode          @default(FIXED)
  pricingMode       BundlePricingMode   @default(PRODUCT_PRICE)
  minimumSelections Int?
  maximumSelections Int?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  groups            ProductBundleGroup[]
  items             ProductBundleItem[]

  @@index([isActive, mode])
}

model ProductBundleGroup {
  id                String                    @id @default(uuid()) @db.Uuid
  bundleId          String                    @db.Uuid
  code              String
  name              String
  minimumSelections Int                       @default(0)
  maximumSelections Int?
  sortOrder         Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @default(now()) @updatedAt
  bundle            ProductBundle             @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  items             ProductBundleItem[]
  cartSelections    CartItemBundleSelection[]

  @@unique([bundleId, code])
  @@index([bundleId, sortOrder])
}

model ProductBundleItem {
  id               String              @id @default(uuid()) @db.Uuid
  bundleId         String              @db.Uuid
  productId        String              @db.Uuid
  groupId          String?             @db.Uuid
  quantity         Int                 @default(1)
  isRequired       Boolean             @default(false)
  minimumQuantity  Int                 @default(0)
  maximumQuantity  Int?
  priceDeltaCents  Int                 @default(0)
  sortOrder        Int                 @default(0)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt
  bundle           ProductBundle       @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  group            ProductBundleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([bundleId, productId, groupId])
  @@index([bundleId, isActive, sortOrder])
}

model ProductPersonalization {
  id                    String   @id @default(uuid()) @db.Uuid
  productId             String   @unique @db.Uuid
  allowGiftMessage      Boolean  @default(false)
  allowRecipientName    Boolean  @default(false)
  allowSpecialPackaging Boolean  @default(false)
  specialPackagingCents Int      @default(0)
  allowRequestedDate    Boolean  @default(false)
  allowNotes            Boolean  @default(false)
  allowHidePrice        Boolean  @default(false)
  messageMaxLength      Int      @default(300)
  notesMaxLength        Int      @default(500)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CartItemBundleSelection {
  id                  String              @id @default(uuid()) @db.Uuid
  cartItemId          String              @db.Uuid
  componentProductId  String              @db.Uuid
  groupId             String?             @db.Uuid
  quantity            Int
  unitPriceDeltaCents Int                 @default(0)
  createdAt           DateTime            @default(now())
  cartItem            CartItem            @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  componentProduct    Product             @relation(fields: [componentProductId], references: [id], onDelete: Restrict)
  group               ProductBundleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([cartItemId, componentProductId, groupId])
}

model CartItemPersonalization {
  id              String   @id @default(uuid()) @db.Uuid
  cartItemId      String   @unique @db.Uuid
  data            Json
  extraPriceCents Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  cartItem        CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
}

model OrderItemBundleSelection {
  id                  String    @id @default(uuid()) @db.Uuid
  orderItemId         String    @db.Uuid
  componentProductId  String?   @db.Uuid
  componentName       String
  componentSku        String
  quantity            Int
  unitPriceDeltaCents Int       @default(0)
  createdAt           DateTime  @default(now())
  orderItem           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  componentProduct    Product?  @relation(fields: [componentProductId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
}

model OrderItemPersonalization {
  id              String    @id @default(uuid()) @db.Uuid
  orderItemId     String    @unique @db.Uuid
  data            Json
  extraPriceCents Int       @default(0)
  createdAt       DateTime  @default(now())
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}
