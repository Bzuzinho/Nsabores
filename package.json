{
  "name": "nsabores",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 turbo dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 turbo build",
    "start": "node scripts/railway-start.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:install": "pnpm --filter @nsabores/api prisma:seed:demo",
    "demo:clear": "pnpm --filter @nsabores/api prisma:seed:demo:clear",
    "demo:reset": "pnpm --filter @nsabores/api prisma:seed:demo:reset",
    "demo:validate": "pnpm --filter @nsabores/api prisma:seed:demo:validate"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  }
}
