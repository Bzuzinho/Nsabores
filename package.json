{
  "name": "nsabores",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 turbo dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 turbo build",
    "start": "node scripts/railway-start.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:load": "pnpm --filter @nsabores/api demo:load",
    "demo:install": "pnpm run demo:load",
    "demo:remove": "pnpm --filter @nsabores/api demo:remove",
    "demo:clear": "pnpm run demo:remove",
    "demo:reset": "pnpm --filter @nsabores/api demo:reset",
    "demo:check": "pnpm --filter @nsabores/api demo:check",
    "demo:validate": "pnpm run demo:check"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.5.5",
    "typescript": "^5.9.3"
  }
}
