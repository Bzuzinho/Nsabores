# Shared
NODE_ENV=development

# Frontend (use http://localhost:3001 for management)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# API
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
PASSWORD_RESET_TOKEN_TTL=1h
EMAIL_VERIFICATION_TOKEN_TTL=24h
WEBSITE_URL=http://localhost:3000
MANAGEMENT_URL=http://localhost:3001

# Optional one-time bootstrap. Remove after the first successful seed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
