# Shared
NODE_ENV=development

# Frontend (use http://localhost:3001 for management)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# Domínios de produção
# Website: https://www.nsabores.pt
# Management: https://app.nsabores.pt
# API: https://api.nsabores.pt

# API
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
PASSWORD_RESET_TOKEN_TTL=1h
EMAIL_VERIFICATION_TOKEN_TTL=24h
WEBSITE_URL=http://localhost:3000
MANAGEMENT_URL=http://localhost:3001

# Pagamentos: manual é a única modalidade operacional atual
PAYMENT_FLOW_MODE=manual
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
PAYMENT_SUCCESS_URL=http://localhost:3000/checkout/sucesso
PAYMENT_CANCEL_URL=http://localhost:3000/checkout/erro

# Email transacional
# `log` não envia mensagens externas. `outlook-graph` usa OAuth2 delegado.
MAIL_PROVIDER=log
MAIL_FROM_ADDRESS=nsabores@outlook.pt
MAIL_REPLY_TO=nsabores@outlook.pt
OUTLOOK_TENANT=consumers
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=

# Optional one-time bootstrap. Define email and hash em conjunto.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
